{
  "name": "orc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent orchestration: workflows in TypeScript, agents in sandboxes, evidence from exit codes.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
