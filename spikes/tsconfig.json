{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "lib",
    "00-harness",
    "01-veto",
    "02-drive",
    "03-submit",
    "04-attach",
    "05-events",
    "06-trust"
  ]
}
